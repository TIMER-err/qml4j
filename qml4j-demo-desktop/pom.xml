<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.timer-err</groupId>
        <artifactId>qml4j-parent</artifactId>
        <version>0.2.32</version>
    </parent>

    <artifactId>qml4j-demo-desktop</artifactId>

    <!-- Demo app, not a published library: never deploy it to Central.
         Inherits the parent's release=8 (Skija supports Java 8). -->
    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.timer-err</groupId>
            <artifactId>qml4j-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.humbleui</groupId>
            <artifactId>skija-shared</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.humbleui</groupId>
            <artifactId>skija-linux-x64</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl</artifactId>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-glfw</artifactId>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-opengl</artifactId>
        </dependency>

        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl</artifactId>
            <classifier>${lwjgl.natives}</classifier>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-glfw</artifactId>
            <classifier>${lwjgl.natives}</classifier>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-opengl</artifactId>
            <classifier>${lwjgl.natives}</classifier>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- No bundled QML for the runner (it's pointed at a project dir at runtime,
             DirResourceLoader). Exceptions are what the `app` mode's classpath loader
             needs and a project dir wouldn't supply: our StyleManager-driven Theme.qml
             and the engine's fonts (Material Symbols icons + Roboto). On the classpath
             for dev runs and the dist jar alike. -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>${project.basedir}/../shared-qml/md3/Core</directory>
                <targetPath>md3/Core</targetPath>
                <includes>
                    <include>Theme.qml</include>
                </includes>
            </resource>
            <resource>
                <directory>${project.basedir}/../shared-qml/fonts</directory>
                <targetPath>fonts</targetPath>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <mainClass>io.github.timer_err.qml4j.demo.DesktopMain</mainClass>
                </configuration>
            </plugin>
            <!-- Excluded from the Central bundle (config merges with the parent's
                 release-profile plugin when -Prelease is active). -->
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <configuration>
                    <skipPublishing>true</skipPublishing>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!-- `mvn -pl qml4j-demo-desktop -Pdist package` builds a self-contained, cross-platform
         fat jar (target/qml4j-app.jar) that runs the bundled MD3 app. It carries both Linux
         and Windows natives (Skija + LWJGL), bundles the upstream app source from ${mcq.dir}
         under /mcq/**, and is a multi-release jar (Skija needs its JDK 9+ Cleanable). The app
         source clone is not in this repo; point mcq.dir at it (default ../../mcq). -->
    <profiles>
        <!-- On a non-Linux desktop, select the matching LWJGL and Skija native artifacts.
             Platform-specific launcher requirements are handled separately. -->
        <profile>
            <id>windows-dev</id>
            <activation>
                <os>
                    <family>windows</family>
                    <arch>amd64</arch>
                </os>
            </activation>
            <properties>
                <lwjgl.natives>natives-windows</lwjgl.natives>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>io.github.humbleui</groupId>
                    <artifactId>skija-windows-x64</artifactId>
                    <version>${skija.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>macos-x64-dev</id>
            <activation>
                <os>
                    <family>mac</family>
                    <arch>x86_64</arch>
                </os>
            </activation>
            <properties>
                <lwjgl.natives>natives-macos</lwjgl.natives>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>io.github.humbleui</groupId>
                    <artifactId>skija-macos-x64</artifactId>
                    <version>${skija.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>macos-arm64-dev</id>
            <activation>
                <os>
                    <family>mac</family>
                    <arch>aarch64</arch>
                </os>
            </activation>
            <properties>
                <lwjgl.natives>natives-macos-arm64</lwjgl.natives>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>io.github.humbleui</groupId>
                    <artifactId>skija-macos-arm64</artifactId>
                    <version>${skija.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>dist</id>
            <properties>
                <mcq.dir>${project.basedir}/../../mcq</mcq.dir>
                <!-- Keep the Linux+Windows bundle independent of host-activated dev profiles. -->
                <lwjgl.natives>natives-linux</lwjgl.natives>
            </properties>
            <dependencies>
                <!-- Linux natives come from the base deps; add the Windows ones so the one
                     jar runs on both. Each native loader picks its platform's lib at runtime. -->
                <dependency>
                    <groupId>io.github.humbleui</groupId>
                    <artifactId>skija-windows-x64</artifactId>
                    <version>${skija.version}</version>
                    <scope>runtime</scope>
                </dependency>
                <dependency>
                    <groupId>org.lwjgl</groupId>
                    <artifactId>lwjgl</artifactId>
                    <classifier>natives-windows</classifier>
                    <scope>runtime</scope>
                </dependency>
                <dependency>
                    <groupId>org.lwjgl</groupId>
                    <artifactId>lwjgl-glfw</artifactId>
                    <classifier>natives-windows</classifier>
                    <scope>runtime</scope>
                </dependency>
                <dependency>
                    <groupId>org.lwjgl</groupId>
                    <artifactId>lwjgl-opengl</artifactId>
                    <classifier>natives-windows</classifier>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <!-- Bundle the upstream app source under /mcq/** and write the Controls
                         index the bundled AppResourceLoader reads (a jar entry can't be listed
                         like a directory at runtime). -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>bundle-mcq</id>
                                <phase>prepare-package</phase>
                                <goals><goal>run</goal></goals>
                                <configuration>
                                    <target>
                                        <property name="out" value="${project.build.outputDirectory}/mcq"/>
                                        <copy todir="${out}/App">
                                            <fileset dir="${mcq.dir}/src/App"
                                                     excludes="**/CMakeLists.txt,**/*.cpp,**/*.h,**/*.rc"/>
                                        </copy>
                                        <copy todir="${out}/Core/Controls">
                                            <fileset dir="${mcq.dir}/src/Core/Controls" includes="**/*.qml"/>
                                        </copy>
                                        <copy todir="${out}/Core/Styles">
                                            <fileset dir="${mcq.dir}/src/Core/Styles"/>
                                        </copy>
                                        <fileset id="ctrls" dir="${out}/Core/Controls" includes="*.qml"/>
                                        <pathconvert property="ctrl.index" refid="ctrls" pathsep="&#10;">
                                            <mapper type="flatten"/>
                                        </pathconvert>
                                        <echo file="${out}/Core/Controls.index" message="${ctrl.index}&#10;"/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-shade-plugin</artifactId>
                        <version>3.5.3</version>
                        <executions>
                            <execution>
                                <phase>package</phase>
                                <goals><goal>shade</goal></goals>
                                <configuration>
                                    <createDependencyReducedPom>false</createDependencyReducedPom>
                                    <finalName>qml4j-app</finalName>
                                    <!-- macos-*-dev auto-activates on a mac build host and adds its runtime
                                         Skija native; exclude the macOS Skija artifacts (precise coords, not
                                         a wildcard) so the shaded jar stays Linux+Windows regardless of build
                                         host. Shade-only: normal dev/exec dependency resolution is unaffected. -->
                                    <artifactSet>
                                        <excludes>
                                            <exclude>io.github.humbleui:skija-macos-x64</exclude>
                                            <exclude>io.github.humbleui:skija-macos-arm64</exclude>
                                        </excludes>
                                    </artifactSet>
                                    <filters>
                                        <filter>
                                            <artifact>*:*</artifact>
                                            <excludes>
                                                <exclude>META-INF/*.SF</exclude>
                                                <exclude>META-INF/*.DSA</exclude>
                                                <exclude>META-INF/*.RSA</exclude>
                                                <exclude>module-info.class</exclude>
                                                <exclude>META-INF/versions/*/module-info.class</exclude>
                                            </excludes>
                                        </filter>
                                    </filters>
                                    <transformers>
                                        <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                            <mainClass>io.github.timer_err.qml4j.demo.DistMain</mainClass>
                                            <manifestEntries>
                                                <Multi-Release>true</Multi-Release>
                                            </manifestEntries>
                                        </transformer>
                                    </transformers>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
